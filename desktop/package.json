{
  "name": "my-agent-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "build": "vite build",
    "start": "dotnet build ../backend/Agent.Host/Agent.Host.csproj && npm run build && electron .",
    "package:win": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@lucide/vue": "^1.30.0",
    "markdown-it": "^14.1.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "33.4.11",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.flowersea.qianagent",
    "productName": "QianAgent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/publish/win-x64",
        "to": "backend"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "resources/qian-agent.ico"
    }
  }
}
